# Local API. `npm run stack` fills the keys in .env.local.
# Hosted Supabase: use the project URL, anon key, and service role key from the dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox public token. The globe uses Mapbox GL JS when this is set.
# Without it, YalePaths draws a paper globe from Natural Earth and keeps the list usable.
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Shown on the public page for members who lose inbox access and need removal.
NEXT_PUBLIC_SUPPORT_EMAIL=removal@yalepaths.local

# Public origin. Set this in production so the CAS callback matches the URL Yale redirects to.
# Leave it unset on localhost.
# NEXT_PUBLIC_SITE_URL=https://yalepaths.example

# Local mailbox sign-in for the test scripts. Leave unset in production.
# YALEPATHS_DEV_EMAIL_SIGNIN=true
